{
  "name": "fieldmaps-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "start": "EXPO_NO_DOTENV=1 expo start --dev-client",
    "ios": "EXPO_NO_DOTENV=1 expo run:ios",
    "android": "EXPO_NO_DOTENV=1 expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "start:simulator": "EXPO_NO_DOTENV=1 node --dns-result-order=ipv4first node_modules/expo/bin/cli start --dev-client --localhost"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@maplibre/maplibre-react-native": "11.3.10",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.23",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "^57.0.23",
    "ky": "^2.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@react-native/metro-config": "0.86.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.7",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
