# =============================================================================
# Dependencies
# =============================================================================
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# =============================================================================
# Next.js / React / TypeScript (applies to all apps in repo)
# =============================================================================
.next/
out/
build/
dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/
.nyc_output/

# =============================================================================
# Environment & secrets (API keys, ArcGIS tokens, AI provider keys)
# =============================================================================
.env
.env.*
!.env.example
!.env.template
!.env.local.example

# =============================================================================
# Package managers & debug logs
# =============================================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =============================================================================
# Deployment
# =============================================================================
.vercel
.netlify

# =============================================================================
# OS & editor noise
# =============================================================================
.DS_Store
Thumbs.db
*.pem

# IDE — ignore local workspace state, keep shared config if you add it later
.idea/
*.swp
*.swo
*~

# VS Code — uncomment if you don't want to share workspace settings
# .vscode/

# =============================================================================
# AI / agent tooling (local state & caches — keep shareable rules/skills)
# =============================================================================

# Cursor — local hook/runtime state (keep .cursor/rules/ if you add them)
.cursor/hooks/
.cursor/**/*.log
.cursor/**/state/

# Claude Code — local-only settings
.claude/settings.local.json
.claude/**/*.local.json
.claude/cache/
.claude/.tmp/

# Aider
.aider*
.aider.chat.history.md

# Continue.dev
.continue/

# Windsurf / Codeium-style local config
.windsurf/
.codeium/

# Generic AI caches & scratch output
*.ai.cache
.ai/
.ai-temp/
prompt-cache/
.llm-cache/

# OpenAI / LangChain / vector DB local dev artifacts
.openai/
.langchain/
.chroma/
.qdrant/
.pinecone/
.weaviate/

# Copilot / agent scratch files
*.copilot.md
.agent-output/
scratch/

# Agent Skills
# skills-lock.json: This is a lock file for the agent skills. Keep this instead of the individual skill directories.
.agents/skills/
.claude/skills/
.cursor/skills/
**/.mcp.json

